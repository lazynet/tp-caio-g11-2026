#!/usr/bin/env bash
# El repo es público: lo que se pushea no se puede despublicar. Este chequeo corre
# antes de cada commit, que es el último punto donde un dato privado todavía no salió.
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
"$root/scripts/leak-check.sh" --staged
"$root/scripts/okf-check.sh" --staged
